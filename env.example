# Copy to .env and fill in the values we provided.
#   cp env.example .env

# --- LLM Provider ---------------------------------------------------------------

# OpenAI Agents SDK. Bring your own key.
OPENAI_API_KEY=
# Silences a harmless tracing 403 from the OpenAI Agents SDK. Leave as-is if using OpenAI.
OPENAI_AGENTS_DISABLE_TRACING=1
# ...or use Google's Agent Development Kit (ADK) instead — set this and adapt the scaffold.
# GOOGLE_API_KEY=

# --- Avis API (mock, for this take-home) ----------------------------------------

# Obtain the mock API key through the assignment's private credential channel.
# Do not put a credential, password-manager share link, or other secret-delivery link in Git.
AVIS_API_KEY=
AVIS_API_URL=https://avis-mock-api-production.up.railway.app
# Maximum retry attempts on transient failures (5xx, timeout)
#AVIS_MAX_ATTEMPTS=4
# Timeout on API calls (seconds)
#AVIS_TIMEOUT_S=15

# --- Agent Configuration -------------------------------------------------------

# LLM model for the agent (DECISIONS.md §3)
#AGENT_MODEL=gpt-4.1

# --- Knowledge-Base Retrieval (DECISIONS.md §2 & §4) ---------------------------

# Mode: lexical (deterministic, default) | shadow (logs librarian counterfactual) | librarian (serves librarian)
# - lexical: fast, no LLM call on policy path, known homonym limitations
# - shadow: runs librarian in parallel, logs comparison, lexical still served
# - librarian: serves librarian output (with lexical fallback on any failure)
#KB_RETRIEVAL_MODE=lexical
# Model for librarian retrieval (if mode is shadow or librarian)
#KB_LIBRARIAN_MODEL=gpt-4.1-mini
# Timeout for librarian call (seconds); if exceeded, falls back to lexical
#KB_LIBRARIAN_TIMEOUT_S=3

# --- Feature Flags (DECISIONS.md §4) -------------------------------------------

# Flexible date alternatives (off | shadow | on). See DECISIONS.md §4 for behavioral detail.
#FLEXIBLE_DATE_ALTERNATIVES_MODE=off
# Budget for concurrent alternative-date quoting (seconds)
#ALTERNATIVE_QUOTE_BUDGET_S=4
# Materiality threshold for alternative-date suggestions (dollar amount, absolute)
#ALTERNATIVE_MATERIALITY_ABS_USD=15
# Materiality threshold for alternative-date suggestions (as % of primary quote)
#ALTERNATIVE_MATERIALITY_PCT=0.10

# In-flow membership upgrade offer (default off, DECISIONS.md §4)
#IN_FLOW_UPGRADE_OFFER=off

# Cancel retention prompt (default off, DECISIONS.md §4)
#CANCEL_RETENTION_PROMPT=off

# --- Money & Gating Configuration ----------------------------------------------

# Variance thresholds (post-write reconciliation, DECISIONS.md §3)
# Extend write: if charged amount differs by this much (cents) from quote, escalate
#EXTEND_VARIANCE_THRESHOLD_USD=0.01
# Cancel write: if penalty/refund differs by this much from estimate, escalate
#CANCEL_VARIANCE_THRESHOLD_USD=1.00

# Verification attempts before escalation (email-verify on write, DECISIONS.md §3)
#MAX_VERIFICATION_ATTEMPTS=3

# Quote TTL: how long a quoted price remains valid before re-quoting (seconds)
#QUOTE_TTL_SECONDS=120

# --- Logging (DECISIONS.md §8) -------------------------------------------------

# Log directory (defaults to logs/ in the project root)
#LOG_DIR=logs
